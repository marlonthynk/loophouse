{
  "name": "loophouse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "browser:install": "playwright install chromium",
    "browser:check": "node scripts/browser-check.mjs",
    "verify": "node scripts/verify.mjs",
    "test:report": "playwright show-report artifacts/playwright/report",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "idb": "latest",
    "jspdf": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "3.9.10",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
